{
  "ref": {
    "$description": "Raw values. Stylesheets bind to sys tokens, never to these.",
    "color": {
      "$type": "color",
      "white": { "$value": "#ffffff" },
      "gray-50": { "$value": "#f4f5f7" },
      "gray-200": { "$value": "#d3d7de" },
      "gray-650": { "$value": "#525a67" },
      "gray-900": { "$value": "#16191d" },
      "night-950": { "$value": "#111316" },
      "night-900": { "$value": "#1b1e23" },
      "night-700": { "$value": "#3b414b" },
      "night-300": { "$value": "#a9b0bb" },
      "night-100": { "$value": "#e7e9ec" },
      "blue-700": { "$value": "#1d4ed8" },
      "blue-300": { "$value": "#9dbcff" },
      "violet-700": { "$value": "#6d28d9" },
      "violet-300": { "$value": "#d2b8ff" },
      "amber-50": { "$value": "#fff6dc" },
      "amber-900": { "$value": "#5a3c00" },
      "amber-950": { "$value": "#2e2300" },
      "amber-200": { "$value": "#ffe4a3" }
    },
    "font": {
      "$type": "fontFamily",
      "sans": {
        "$value": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
      },
      "mono": {
        "$value": "ui-monospace, SFMono-Regular, Menlo, Consolas, \"DejaVu Sans Mono\", monospace"
      }
    }
  },
  "sys": {
    "$description": "Semantic roles the stylesheet binds to. Colors carry their dark value in $extensions.modes.",
    "color": {
      "$type": "color",
      "surface": {
        "$description": "Page background; also the browser theme-color.",
        "$value": "{ref.color.white}",
        "$extensions": {
          "modes": {
            "light": "{ref.color.white}",
            "dark": "{ref.color.night-950}"
          }
        }
      },
      "surface-raised": {
        "$description": "Code blocks, table headers and asides.",
        "$value": "{ref.color.gray-50}",
        "$extensions": {
          "modes": {
            "light": "{ref.color.gray-50}",
            "dark": "{ref.color.night-900}"
          }
        }
      },
      "text": {
        "$value": "{ref.color.gray-900}",
        "$extensions": {
          "modes": {
            "light": "{ref.color.gray-900}",
            "dark": "{ref.color.night-100}"
          }
        }
      },
      "text-muted": {
        "$description": "Dates, captions and metadata; at least 4.5:1 on both surfaces.",
        "$value": "{ref.color.gray-650}",
        "$extensions": {
          "modes": {
            "light": "{ref.color.gray-650}",
            "dark": "{ref.color.night-300}"
          }
        }
      },
      "link": {
        "$value": "{ref.color.blue-700}",
        "$extensions": {
          "modes": {
            "light": "{ref.color.blue-700}",
            "dark": "{ref.color.blue-300}"
          }
        }
      },
      "link-visited": {
        "$value": "{ref.color.violet-700}",
        "$extensions": {
          "modes": {
            "light": "{ref.color.violet-700}",
            "dark": "{ref.color.violet-300}"
          }
        }
      },
      "border": {
        "$value": "{ref.color.gray-200}",
        "$extensions": {
          "modes": {
            "light": "{ref.color.gray-200}",
            "dark": "{ref.color.night-700}"
          }
        }
      },
      "focus": {
        "$description": "Focus outline; 3:1 against the surface (WCAG 2.2 SC 1.4.11).",
        "$value": "{ref.color.blue-700}",
        "$extensions": {
          "modes": {
            "light": "{ref.color.blue-700}",
            "dark": "{ref.color.blue-300}"
          }
        }
      },
      "notice-surface": {
        "$value": "{ref.color.amber-50}",
        "$extensions": {
          "modes": {
            "light": "{ref.color.amber-50}",
            "dark": "{ref.color.amber-950}"
          }
        }
      },
      "notice-text": {
        "$value": "{ref.color.amber-900}",
        "$extensions": {
          "modes": {
            "light": "{ref.color.amber-900}",
            "dark": "{ref.color.amber-200}"
          }
        }
      }
    },
    "font": {
      "$type": "fontFamily",
      "body": { "$value": "{ref.font.sans}" },
      "code": { "$value": "{ref.font.mono}" }
    },
    "size": {
      "$type": "dimension",
      "measure": {
        "$description": "Width of the text column.",
        "$value": "42rem"
      },
      "gutter": { "$value": "1rem" },
      "space": { "$value": "1.5rem" },
      "radius": { "$value": "4px" }
    }
  }
}
